import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";

function dummyToast(msg) { /* noop */ }

async function fetcher() { return {}; }
// import { fetcher } from "../../services/api";
// import { toast } from "../../components/Common/Toast";

export interface AuthUser {
  id: string;
  display_name: string;
  email: string;
  department: string;
  role: string;
  avatar: string;
  photo_url?: string;
}

/**
 * UserProfile - renders the current loggedin user's avatar and basic info.
 * It fetches the profile from `/users/me` and offers a logout button.
 */
export const UserProfile: React.FC = () => {
  const navigate = useNavigate();
  const [user, setUser] = useState<AuthUser | null>(null);
  const [loading, setLoading] = useState<boolean>(true);

  useEffect(() => {
    const loadProfile = async () => {
      try {
        const data = await fetcher<AuthUser>("/users/me");
        setUser(data);
      } catch (err) {
        toast.error("Failed to load user profile");
      } finally {
        setLoading(false);
      }
    };
    loadProfile();
  }, []);

  const handleLogout = () => {
    // clear stored tokens (localStorage used by AuthService)
    localStorage.removeItem("access_token");
    localStorage.removeItem("refresh_token");
    localStorage.removeItem("remember_me");
    toast.success("You have been logged out");
    navigate("/login");
  };

  if (loading) {
    return <div className="p-4">Loading profile...</div>;
  }

  if (!user) {
    return null;
  }

  return (
    <div className="flex items-center space-x-3">
      <img
        src={user.avatar ?? "/avatars/default.jpg"}
        alt={`${user.display_name} avatar`}
        className="w-10 h-10 rounded-full"
      />
      <div className="text-sm">
        <div className="font-medium">{user.display_name}</div>
        <div className="text-gray-500">{user.department}</div>
      </div>
      <button
        onClick={handleLogout}
        className="ml-4 text-sm text-red-600 hover:underline"
        aria-label="Log out"
      >
        Logout
      </button>
    </div>
  );
};

export default UserProfile;
